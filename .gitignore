# Secrets et fichiers locaux
.env
.env.*
*.pem
*.pfx
*.p12
*.key
*.cer
*.crt
secrets/
tokens/
*.token
*.jwt

# Captures d'ecran
# Par defaut aucune image n'est suivie : les ecrans Microsoft Entra exposent
# Tenant ID, Object ID, adresses de messagerie et Correlation ID.
# Seul screenshots/ est autorise, et uniquement apres masquage verifie.
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.webp
*.pdf
!screenshots/*.png

# Captures sources non masquees : ne jamais publier
_captures_brutes/

# Sauvegardes locales
.bak/
*.bak
*.orig

# OS et editeurs
.DS_Store
._*
Thumbs.db
.vscode/
.idea/
*.swp
